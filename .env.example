# Telegram
# BOT_TOKEN: токен бота от @BotFather
BOT_TOKEN=
# ADMIN_IDS: id администраторов через запятую/пробел
ADMIN_IDS=

# Database (asyncpg DSN)
DATABASE_URL=postgresql+asyncpg://playnext:playnext@localhost:5432/playnext

# Payments — опционально, без токена доступны только демо-пополнения
# CRYPTO_PAY_TOKEN: токен @CryptoBot -> Crypto Pay
CRYPTO_PAY_TOKEN=
# CRYPTO_PAY_TESTNET: true -> @CryptoTestnetBot
CRYPTO_PAY_TESTNET=false

# Observability — опционально
SENTRY_DSN=

# Runtime
# ENVIRONMENT: local | production
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=false
CURRENCY=RUB
